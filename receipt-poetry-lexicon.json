      "{noun} {verb} {state}",
      "{timeWord} {fragment}",
      "{spaceWord} {fragment}",
      "{adjective} {noun} {verb}"
    ],
    "haikuLike": [
      "{adjective} {noun} / {verb} {spaceWord} / {singleWord}",
      "{timeWord} / {noun} {verb} / {state}",
      "{spaceWord} {noun} / {adjective} {traceWord} / {singleWord}"
    ],
    "oddGesture": [
      "{asciiGlyph} {singleWord}",
      "{onomatopoeia} {asciiGlyph}",
      "{asciiGlyph} {asciiGlyph} {noun}",
      "{singleWord} {asciiGlyph} {singleWord}",
      "{onomatopoeia} {fragment}"
    ],
